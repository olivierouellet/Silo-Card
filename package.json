{
  "name": "silo-card",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "yarn@4.12.0",
  "description": "Lovelace card that draws a grain silo or bin, section by section, and shows how full it is from a distance sensor at the top · Carte Lovelace qui dessine un silo à grains et indique son niveau",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "lovelace",
    "custom-cards",
    "silo",
    "grain-bin",
    "esphome"
  ],
  "module": "silo-card.js",
  "repository": "github:olivierouellet/Silo-Card",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@mdi/js": "^7.4.47",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "rollup": "^4.20.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-serve": "^3.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "rollup -c rollup.config.dev.js --watch",
    "build": "yarn clean && yarn lint && yarn typecheck && yarn test && yarn rollup",
    "clean": "rm -rf dist",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' && node scripts/check-translations.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rollup": "rollup -c"
  }
}
